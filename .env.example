# Copy to .env and fill in. NEVER commit .env, and never put real values in this file.
# Values with special characters must be quoted so `source .env` works in Git Bash.

# --- Make ---
# Custom webhook URL from M01 (treat as a secret)
MAKE_WEBHOOK_URL="https://hook.<region>.make.com/<webhook-id>"
# Webhook API key (Make: M01 → API Key authentication → keychain), sent as header x-make-apikey. Generate with: openssl rand -hex 32
WEBHOOK_SECRET="<64-hex-char-secret>"

# --- Netlify (proxy env vars are set in the Netlify UI; listed here for local `netlify dev`) ---
NETLIFY_SITE_URL="https://<site-name>.netlify.app"
CONTACT_EMAIL="<fallback-contact-address-shown-on-form-errors>"

# --- Gemini ---
# Single source of truth for the model name (DECISIONS #24). Docs refer to it as {GEMINI_MODEL};
# type this value into M13's URL in Make. Change it here first if the model changes.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Key is stored in a Make keychain; kept in .env only for tools/gemini-smoke-test.mjs
GEMINI_API_KEY="<google-ai-studio-api-key>"
# Pause between smoke-test calls in ms (default 15000 = 4 requests/min). Raise it further if AI Studio shows a lower RPM.
SMOKE_DELAY_MS="15000"

# --- Slack (auth lives in Make's "Slack (bot)" connection; no token here) ---
# ID of the private channel #leadflow-alerts (channel name → About tab → bottom; starts with C)
SLACK_CHANNEL_ID="<C0XXXXXXXXX>"

# --- Google Sheets ---
GOOGLE_SHEET_ID="<spreadsheet-id>"

# --- Tests (payload-tester) ---
# Your inbox for routes that send email. Payload files hold only the token {{TEST_EMAIL+<tag>}};
# payload-tester expands it at send time to local+<tag>-<run_id>@domain.
TEST_EMAIL="<you@example.com>"

# --- Email templates ---
BOOKING_URL="https://<your-scheduling-link>"
PORTFOLIO_URL="https://<portfolio-link>"
